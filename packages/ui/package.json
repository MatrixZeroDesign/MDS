{
	"name": "@matrixzero/ui",
	"version": "0.1.0-alpha.14",
	"description": "Matrix Design System — accessible React components and brand-scoped themes",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MatrixZeroDesign/MDS.git",
		"directory": "packages/ui"
	},
	"files": [
		"dist",
		"README.md",
		"CHANGELOG.md"
	],
	"sideEffects": [
		"**/*.css"
	],
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./styles.css": "./dist/styles.css",
		"./themes/mt0.css": "./dist/themes/mt0.css"
	},
	"scripts": {
		"build": "node ../../scripts/clean-ui.mjs && tsc -p tsconfig.json && node ../../scripts/copy-styles.mjs"
	},
	"peerDependencies": {
		"react": "^19.0.0",
		"react-dom": "^19.0.0"
	},
	"dependencies": {
		"@matrixzero/icons": "0.1.0-alpha.4"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org/",
		"access": "public"
	}
}
