{
	"name": "@matrixzero/ui",
	"version": "0.1.0-alpha.4",
	"description": "Matrix Design System — accessible React components and brand-scoped themes",
	"type": "module",
	"license": "UNLICENSED",
	"repository": {
		"type": "git",
		"url": "git+https://gitlab.com/matrixzero/mds.git",
		"directory": "packages/ui"
	},
	"files": [
		"dist",
		"README.md",
		"CHANGELOG.md"
	],
	"sideEffects": [
		"**/*.css"
	],
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./styles.css": "./dist/styles.css",
		"./themes/mt0.css": "./dist/themes/mt0.css"
	},
	"scripts": {
		"build": "node ../../scripts/clean-ui.mjs && tsc -p tsconfig.json && node ../../scripts/copy-styles.mjs"
	},
	"peerDependencies": {
		"react": "^19.0.0",
		"react-dom": "^19.0.0"
	},
	"dependencies": {
		"@matrixzero/icons": "0.1.0-alpha.3",
		"@radix-ui/react-accordion": "1.2.12",
		"@radix-ui/react-avatar": "1.1.10",
		"@radix-ui/react-checkbox": "1.3.3",
		"@radix-ui/react-collapsible": "1.1.12",
		"@radix-ui/react-dialog": "1.1.15",
		"@radix-ui/react-dropdown-menu": "2.1.16",
		"@radix-ui/react-progress": "1.1.7",
		"@radix-ui/react-radio-group": "1.3.8",
		"@radix-ui/react-select": "2.2.6",
		"@radix-ui/react-switch": "1.2.6",
		"@radix-ui/react-tabs": "1.1.13",
		"@radix-ui/react-tooltip": "1.2.8"
	},
	"publishConfig": {
		"registry": "https://gitlab.com/api/v4/projects/86296621/packages/npm/"
	}
}
