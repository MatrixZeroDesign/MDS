{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"jsx": "react-jsx",
		"strict": true,
		"declaration": true,
		"declarationMap": false,
		"sourceMap": true,
		"outDir": "dist",
		"rootDir": "src",
		"skipLibCheck": true,
		"verbatimModuleSyntax": true,
		"inlineSources": true
	},
	"include": ["src"]
}
